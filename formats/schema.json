{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tournament format",
  "description": "Shape of a format file. Rules that a schema cannot express (pool size, picks, known templates and factions) are checked in src/rules/formats.py.",
  "type": "object",
  "required": ["id", "name", "phases"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Lowercase words joined by dashes. Must match the file name." },
    "name": { "type": "string", "minLength": 1, "description": "Name players see, for example El Classico." },
    "status": { "enum": ["active", "archived"], "description": "Archived formats are kept but cannot start new matches. Default: active." },
    "thread_visibility": { "enum": ["public", "private"], "description": "Who can read the match thread. Default: public." },
    "phases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/phase" } }
  },
  "$defs": {
    "tradeSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "difficulty": { "type": "integer", "description": "In-game difficulty in percent. Starting gold follows from it." },
        "roll_cost": { "type": "integer", "minimum": 0, "description": "Gold a player pays to roll the faction pair. Default: 500." },
        "rolls_per_player": { "type": "integer", "minimum": 0, "description": "Default: 1." },
        "max_roll_bans": { "type": "integer", "minimum": 0, "description": "Factions banned per roll, 0 up to this. Default: 2." },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["faction_roll", "faction_bid", "color_bid", "color_toss"] },
          "description": "Trade sections in order. Default follows from the difficulty."
        }
      }
    },
    "phase": {
      "type": "object",
      "required": ["name", "best_of", "pool", "selection", "trade"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "best_of": { "enum": [1, 3, 5] },
        "pool": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Template ids from data/templates.json." },
        "selection": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "steps", "game_order"],
              "additionalProperties": false,
              "properties": {
                "type": { "const": "sequence" },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["who", "do"],
                    "additionalProperties": false,
                    "properties": {
                      "who": { "enum": ["A", "B"], "description": "A is the coinflip winner." },
                      "do": { "enum": ["ban", "pick"] }
                    }
                  }
                },
                "game_order": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^(pick_[1-9][0-9]*|decider)$" },
                  "description": "pick_1 is the first pick step, pick_2 the second, and so on; decider is the leftover template."
                }
              }
            },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": { "type": { "const": "agreed" } }
            }
          ]
        },
        "allowed_factions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Faction ids from data/factions.json. Default: all of them." },
        "trade": {
          "allOf": [{ "$ref": "#/$defs/tradeSettings" }, { "required": ["difficulty"] }]
        },
        "template_overrides": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/tradeSettings" },
          "description": "Trade settings that differ for one template, keyed by template id."
        }
      }
    }
  }
}
